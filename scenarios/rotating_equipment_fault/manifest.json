{
  "schema_version": "1.0",
  "id": "rotating_equipment_fault",
  "name": "旋转设备故障预测",
  "version": "1.0.0",
  "industry": "industrial_maintenance",
  "description": "生成转速、负载、振动、温度、电流、声学量与剩余寿命的确定性测试序列。",
  "seed": 31006,
  "start_time": "2026-01-01T00:00:00Z",
  "frequency_seconds": 60,
  "default_rows": 240,
  "modes": ["baseline", "drift", "fault"],
  "fields": [
    {"name": "timestamp", "type": "string", "role": "index", "unit": "ISO-8601", "description": "UTC采样时间"},
    {"name": "scenario_mode", "type": "string", "role": "metadata", "unit": "1", "description": "场景模式", "enum": ["baseline", "drift", "fault"]},
    {"name": "shaft_speed_rpm", "type": "number", "role": "feature", "unit": "rpm", "description": "轴转速", "minimum": 1350, "maximum": 1550},
    {"name": "motor_load_pct", "type": "number", "role": "feature", "unit": "%", "description": "电机负载", "minimum": 45, "maximum": 90},
    {"name": "vibration_rms_mm_s", "type": "number", "role": "feature", "unit": "mm/s", "description": "振动有效值", "minimum": 1, "maximum": 9},
    {"name": "bearing_temperature_c", "type": "number", "role": "feature", "unit": "degC", "description": "轴承温度", "minimum": 45, "maximum": 95},
    {"name": "motor_current_a", "type": "number", "role": "feature", "unit": "A", "description": "电机电流", "minimum": 60, "maximum": 105},
    {"name": "acoustic_rms", "type": "number", "role": "feature", "unit": "1", "description": "声学归一化有效值", "minimum": 0.25, "maximum": 1.6},
    {"name": "remaining_useful_life_h", "type": "number", "role": "target", "unit": "h", "description": "剩余使用寿命", "minimum": 12, "maximum": 750},
    {"name": "health_label", "type": "string", "role": "ground_truth", "unit": "1", "description": "已知健康状态", "enum": ["healthy", "sensor_drift", "bearing_fault"]}
  ],
  "limitations": ["退化曲线为合成趋势，不代表具体轴承寿命。", "不能替代点检、停机或检修决策。"]
}

