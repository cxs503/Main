{
  "schema_version": "1.0",
  "id": "photovoltaic_power",
  "name": "光伏功率预测",
  "version": "1.0.0",
  "industry": "renewable_energy",
  "description": "生成辐照度、温度、云量、逆变器可用率与光伏有功功率的确定性测试序列。",
  "seed": 31005,
  "start_time": "2026-06-01T00:00:00Z",
  "frequency_seconds": 900,
  "default_rows": 192,
  "modes": ["baseline", "drift", "fault"],
  "fields": [
    {"name": "timestamp", "type": "string", "role": "index", "unit": "ISO-8601", "description": "UTC采样时间"},
    {"name": "scenario_mode", "type": "string", "role": "metadata", "unit": "1", "description": "场景模式", "enum": ["baseline", "drift", "fault"]},
    {"name": "hour_of_day", "type": "number", "role": "feature", "unit": "h", "description": "日内小时", "minimum": 0, "maximum": 23.75},
    {"name": "global_irradiance_w_m2", "type": "number", "role": "feature", "unit": "W/m2", "description": "水平面总辐照度", "minimum": 0, "maximum": 1050},
    {"name": "ambient_temperature_c", "type": "number", "role": "feature", "unit": "degC", "description": "环境温度", "minimum": -5, "maximum": 42},
    {"name": "module_temperature_c", "type": "number", "role": "feature", "unit": "degC", "description": "组件温度", "minimum": -5, "maximum": 75},
    {"name": "cloud_cover_pct", "type": "number", "role": "feature", "unit": "%", "description": "云量", "minimum": 0, "maximum": 95},
    {"name": "inverter_availability", "type": "number", "role": "feature", "unit": "1", "description": "逆变器可用率", "minimum": 0.5, "maximum": 1},
    {"name": "active_power_kw", "type": "number", "role": "target", "unit": "kW", "description": "场站有功功率", "minimum": 0, "maximum": 1000},
    {"name": "condition_label", "type": "string", "role": "ground_truth", "unit": "1", "description": "已知天气或设备工况", "enum": ["normal", "weather_drift", "inverter_derating"]}
  ],
  "limitations": ["太阳位置与天气为简化曲线。", "不能用于真实场站出力承诺或交易预测。"]
}

