{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/industry-scenario-manifest-v1.json",
  "title": "foundation deterministic industry scenario manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "industry", "description", "seed", "start_time", "frequency_seconds", "default_rows", "modes", "fields", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "industry": {"type": "string"},
    "description": {"type": "string"},
    "seed": {"type": "integer"},
    "start_time": {"type": "string", "format": "date-time"},
    "frequency_seconds": {"type": "integer", "minimum": 1},
    "default_rows": {"type": "integer", "minimum": 1, "maximum": 10000},
    "modes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {"enum": ["baseline", "drift", "fault"]}
    },
    "fields": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "role", "unit", "description"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "type": {"enum": ["string", "number", "integer"]},
          "role": {"enum": ["index", "feature", "target", "ground_truth", "metadata"]},
          "unit": {"type": "string"},
          "description": {"type": "string"},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "enum": {"type": "array", "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}

