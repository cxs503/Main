# ===========================================
# 开放数字化底座环境配置示例
# 复制此文件为 .env 并修改配置
# ===========================================

# JWT配置 - 生产环境必须更改！
# 生成安全密钥: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置
DATABASE_URL=postgresql://foundation:foundation123@localhost:5432/open_digital_foundation

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=open-foundation

# CORS配置 - 生产环境必须限制来源！
# 多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# 环境标识 (development/production)
ENVIRONMENT=development

# API限流配置
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
RATE_LIMIT_DEFAULT=100/minute

# 安全配置
SECURE_HEADERS_ENABLED=true

# 日志级别
LOG_LEVEL=INFO
