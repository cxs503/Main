# ===========================================
# 开放数字化底座 - Docker 环境变量配置
# 复制此文件为 .env 并修改配置
# ===========================================

# ==================== 端口配置 ====================
BACKEND_PORT=8001
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# ==================== 数据库配置 ====================
POSTGRES_PASSWORD=foundation123

# ==================== Redis配置 ====================
REDIS_PASSWORD=

# ==================== MinIO配置 ====================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=open-foundation
MINIO_SECURE=false

# ==================== JWT安全配置 ====================
# 生产环境必须更改！使用以下命令生成安全密钥:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-use-64chars
REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production-use-64chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS配置 ====================
# 生产环境必须限制来源，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# ==================== 环境标识 ====================
# development 或 production
ENVIRONMENT=production

# ==================== 日志级别 ====================
LOG_LEVEL=INFO

# ==================== API限流配置 ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ==================== 外部服务（可选）====================
# OpenRouter API密钥（用于AI模型调用）
# OPENROUTER_API_KEY=your-openrouter-api-key
