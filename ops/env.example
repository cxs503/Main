# TensorPlatform native agent worker（本地部署，勿提交）
TENSOR_API_BASE=http://127.0.0.1:8010/api/v1
TENSOR_AGENT_USER=<platform-user>
TENSOR_AGENT_PASS=<change-me>
LLM_BASE_URL=<openai-compatible-gateway>/v1
LLM_API_KEY=<change-me>
LLM_MODEL=qwen3.7-plus
TP_WORK_ROOT=/root/tp-agent/work
TP_AGENT_ID=tp-native-1
TP_MAX_TOOL_CALLS=40
TP_MAX_WALL_SECONDS=1800
TP_PG_DB=tensorplatform

# 常设派发线环境（report_watch / report_qa / operator_shift / sdaa_sweep /
# fleet_optimizer / council 从进程环境读取，与上面 TENSOR_* 等价的双命名）
TP_API_USER=<platform-user>
TP_API_PASS=<change-me>
TP_PG_PASSWORD=<change-me>

# SDAA 加速卡（Tecorigin tcaicard0-31，8卡x4分区，2026-10-29 点亮）
SDAA_HOME=/opt/tecoai
LD_LIBRARY_PATH=/opt/tecoai/lib64
PATH=/opt/tecoai/bin
SDAA_QUIET=1
