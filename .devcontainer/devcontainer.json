{
  "name": "TensorPlatform Full-Stack Preview",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "frontend",
  "workspaceFolder": "/workspaces/TensorPlatform",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Frontend UI (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar"
      ]
    }
  }
}
