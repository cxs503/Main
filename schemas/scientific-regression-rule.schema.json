{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cxs503/TensorPlatform/blob/main/schemas/scientific-regression-rule.schema.json",
  "title": "Tensor Scientific Regression Rule",
  "description": "Machine-readable contract for repository-owned scientific regression rules. A valid record describes metadata; it does not itself prove that a validator ran or that the scientific claim is correct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "title",
    "project",
    "owner",
    "category",
    "severity",
    "lifecycle",
    "statement",
    "rationale",
    "scope",
    "validator",
    "fixtures",
    "acceptance",
    "remediation",
    "reviewed_at",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "static",
        "api_contract",
        "numerical_invariant",
        "solver_regression",
        "benchmark"
      ]
    },
    "severity": {
      "enum": ["info", "warning", "error", "critical"]
    },
    "lifecycle": {
      "enum": ["proposed", "advisory", "blocking", "deprecated"]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "version"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "string",
          "minLength": 1
        },
        "negative": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "remediation": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "commit_sha", "execution_status", "validation_status"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "branch": {"type": "string"},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "rule_revision": {"type": "string"},
          "validator": {"type": "string"},
          "command": {"type": "string"},
          "execution_status": {
            "enum": ["not_run", "running", "passed", "failed", "skipped", "inconclusive"]
          },
          "validation_status": {
            "enum": ["not_run", "running", "passed", "failed", "skipped", "inconclusive"]
          },
          "exit_code": {"type": ["integer", "null"]},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["uri"],
              "properties": {
                "uri": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "size_bytes": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "failure_attribution": {
            "enum": ["introduced", "pre_existing", "environment", "flaky", "unknown"]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
